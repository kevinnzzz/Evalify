# ─── Express Gateway ─────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ─── Railway AI Model APIs ────────────────────────────────────────────────────
# CV Scoring API (Railway deployment)
CV_API_URL=https://evalifycvevaluationscoring-api-production.up.railway.app

# Interview Simulation API (Railway deployment)
